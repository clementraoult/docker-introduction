# ---------- Étape 1 : build (jetée à la fin) ----------
# Tag précis + digest : l'image de base ne peut pas changer à notre insu
FROM node:22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build

WORKDIR /app

# Dépendances d'abord (cache), versions exactes du package-lock.json
COPY package.json package-lock.json ./
RUN npm ci

# Sources (filtrées par .dockerignore), puis compilation vers dist/
COPY . .
RUN npm run build


# ---------- Étape 2 : image finale minimale ----------
# nginx-unprivileged : nginx officiel prévu pour tourner sans root (UID 101, port 8080)
FROM nginxinc/nginx-unprivileged:1.31-alpine3.24@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e

# Correctifs de sécurité Alpine publiés depuis l'image de base, puis suppression
# des outils inutiles à l'exécution (curl, gestionnaire de paquets apk).
# Passage temporaire en root, seul moment où c'est nécessaire.
USER root
RUN apk upgrade --no-cache \
  && apk del --no-cache curl \
  && apk --purge del apk-tools

# Seul le site compilé est copié. Les fichiers appartiennent à root :
# nginx (UID 101) peut les lire mais pas les modifier
COPY --from=build /app/dist /usr/share/nginx/html

# Utilisateur non-root (déjà le défaut de l'image, rendu explicite)
USER 101

EXPOSE 8080

# Vérification de santé : Docker sait si l'appli répond vraiment
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
